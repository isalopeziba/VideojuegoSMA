  m_Script: {fileID: 11500000, guid: 73ff106485a924548a3f3a042e6969b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DuendeNPC
  jugador: {fileID: 0}
  distanciaSeguimiento: 1.92
  margenArranque: 0
  desplazamientoLateral: 0.77
  velocidad: 5
  terrainLayer:
    serializedVersion: 2
    m_Bits: 64
  groundDist: -0.04
  spriteDuende: {fileID: 183342973516319537}
  animator: {fileID: 2545819124968459879}
  animIdle: duende_idle
  animLado: duende_camina
  animAtras: duende_detras
  animFrente: duende_frente
  animSenalando: duende_senalando
  preguntasMohan: {fileID: 0}
  canvasDialogo: {fileID: 2782252842604610393}
  textoDialogo: {fileID: 1526940822696349915}
  duracionMinimaFrase: 3
  segundosPorLetra: 0.06
  frasesInicio:
  - "Este r\xEDo lo cuida el Moh\xE1n. Est\xE1 muy sucio. Ay\xFAdalo y quiz\xE1 te
    escuche."
  - "Dato curioso: el Moh\xE1n viene de las tradiciones de los r\xEDos Magdalena
    y Cauca. Se dice que vive en cuevas bajo el agua y que atrae a los pescadores
    con su m\xFAsica."
  esperaAntesDeInicio: 2
  frasePrimerObjeto: "Eso no es del r\xEDo. Gracias por sacarlo."
  frase25: "\xBFOyes? El r\xEDo empieza a respirar."
  fraseMohanAparece: No tengas miedo. Escucha bien la pregunta.
  fraseError: "Casi. Piensa en qu\xE9 le importa al r\xEDo."
  usosPista: 3
  duracionBrillo: 5
  colorBrillo: {r: 0, g: 0.90373087, b: 1, a: 1}
  efectoBrillo: {fileID: 0}
  frasePistaBasura: "\xA1Mira! All\xED brilla algo que no es del r\xEDo."
  fraseNoHayBasura: "Por aqu\xED ya est\xE1 limpio. Sigue adelante."
  fraseSinPistas: "Ya no me quedan pistas. \xA1T\xFA puedes!"
