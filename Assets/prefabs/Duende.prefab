  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DuendeCueva
  duende: {fileID: 1378532649925318849}
  mochila: {fileID: 0}
  entrada: {fileID: 0}
  salida: {fileID: 0}
  fraseEntrar: "Mucho brillo, \xBFverdad? Piensa: \xBFqu\xE9 necesitas de verdad?"
  fraseComoSalir: "Cuando creas que tienes lo necesario, ve a la puerta y presiona
    Acci\xF3n."
  fraseAlgoTeFalta: Algo te falta...
  fraseRecordarSemillas: "\xBFY las semillas? Las vas a necesitar en el bosque."
