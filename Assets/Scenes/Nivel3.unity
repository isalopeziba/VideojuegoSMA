  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MadremontePreguntas
  textoMadremonte: {fileID: 341073072}
  animator: {fileID: 921262159}
  animIdle: idle
  animAsentir: 
  canvasDialogo: {fileID: 1015807188}
  panelBotones: {fileID: 517723920}
  botones:
  - {fileID: 476490870}
  - {fileID: 273950286}
  - {fileID: 1341438482}
  enunciado: "Aprendiste de ellos. Pero un sue\xF1o se olvida al despertar. \xBFQu\xE9
    har\xE1s cuando abras los ojos?"
  opciones:
  - "Nada, solo fue un sue\xF1o"
  - "Cuidar el monte y contar lo que aprend\xED"
  - Cuidarlo solo cuando alguien me vea
  correcta: 1
  textoAcierto: "Entendiste, joven. El monte no es tuyo: t\xFA eres parte de \xE9l.
    Cu\xEDdalo y no volveras a verme."
  textoFallo: "Un sue\xF1o se olvida; una promesa con actos, no. Piensa de nuevo."
  colorNormal: {r: 1, g: 1, b: 1, a: 1}
  colorCorrecto: {r: 0.35, g: 0.85, b: 0.35, a: 1}
  colorIncorrecto: {r: 0.9, g: 0.3, b: 0.3, a: 1}
