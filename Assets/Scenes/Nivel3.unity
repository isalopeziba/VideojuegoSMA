  m_Script: {fileID: 11500000, guid: 96ab24a285a2a294f85128cf5b4f355c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ConversacionFinal
  globoJugador:
    canvas: {fileID: 956164256}
    texto: {fileID: 165103421}
  globoMadremonte:
    canvas: {fileID: 1015807188}
    texto: {fileID: 341073072}
  globoDuende:
    canvas: {fileID: 1914007319}
    texto: {fileID: 1582843712}
  dialogoJugador1: Lo prometo. Perdon por lo que hice
  dialogoJugador2: "\xBFTe volver\xE9 a ver?"
  dialogoMadremonte1: "Las promesas se cumplen con actos. Ve y repara lo que qued\xF3
    en tu mundo."
  dialogoMadremonte2: Cumpliste tu encargo, Duende.
  dialogoDuende1: "Lo logr\xE9. Ahora sabes que las leyendas tambi\xE9n ense\xF1an
    a cuidar el territorio."
  dialogoDuende2: "Siempre que sue\xF1es con el monte, ah\xED estar\xE9.Pero antes
    de decir adios, quiero decirte un dato curioso"
  dialogoDuende3: "Sabias que en muchas regiones se cuenta que la Madremonte desorienta
    a quienes da\xF1an el monte, por eso la leyenda funciona como un llamado a cuidarlo"
  duracionMinima: 4
  segundosPorLetra: 0.06
  portal: {fileID: 1405384935}
  alTerminar:
    m_PersistentCalls:
      m_Calls: []
  sonidoPortal: {fileID: 8300000, guid: 66dc7b4b3a11f8c4fb6816f7a3847dc7, type: 3}
  audioSourcePortal: {fileID: 1775241750}
